{
  "schemaVersion": 2,
  "projectRoot": "<derived-from-.agents-directory>",
  "defaultBudgetUsd": 0.2,
  "defaults": {
    "bare": true,
    "maxFilesRead": 20,
    "maxCommands": 8
  },
  "modes": {
    "plan": {
      "permissionMode": "plan",
      "outputFormat": "stream-json",
      "allowedTools": ["Read", "Glob", "Grep", "LS"],
      "disallowedTools": ["Bash", "Edit", "Write"],
      "mayModifyFiles": false
    },
    "run": {
      "permissionMode": "acceptEdits",
      "outputFormat": "stream-json",
      "allowedTools": ["Read", "Glob", "Grep", "LS", "Edit", "Write"],
      "disallowedTools": ["Bash"],
      "mayModifyFiles": true,
      "requiresApproval": true
    },
    "review": {
      "permissionMode": "plan",
      "outputFormat": "stream-json",
      "allowedTools": ["Read", "Glob", "Grep", "LS"],
      "disallowedTools": ["Bash", "Edit", "Write"],
      "mayModifyFiles": false
    }
  },
  "safety": {
    "denyDangerousPermissionBypass": true,
    "denyProjectRootEscapeByDefault": true,
    "denySecretsAndGlobalConfig": true,
    "denyRecursiveDelete": true,
    "denyGitCommitOrPush": true,
    "denyNetworkAndDependencyInstallByDefault": true,
    "redactEnvironmentValues": true
  },
  "approvalRequiredFor": [
    "editing project files",
    "running tests or build commands",
    "creating artifacts",
    "installing dependencies",
    "network access",
    "changing project configuration",
    "adding directories outside the project root"
  ]
}
